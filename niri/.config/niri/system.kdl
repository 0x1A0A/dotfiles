spawn-sh-at-startup "noctalia"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
hotkey-overlay {
    skip-at-startup
}
input {
    keyboard {
        xkb {
            layout "us,th"
            options "grp:alt_shift_toggle"
        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed -0.2
        scroll-factor 0.2
    }
    mouse {
        accel-speed 0.7
        accel-profile "flat"
    }
}
gestures {
    hot-corners {
        off
    }
}
overview {
    backdrop-color "#1a1a1a"
    workspace-shadow {
        off
    }
}

